@startuml av2_flujo_trabajo
!include _estilo.iuml
title Flujo de trabajo: de los datos a la decisión de acompañamiento
|Sistema académico|
start
:Cierre del periodo académico\n(notas, asistencia, matrícula, aula virtual);
|Administración de TI|
:Ejecutar procesos por lotes\n(python -m scripts.pipeline);
|Sistema de alerta temprana|
:ETL → entrenamiento (si corresponde)\n→ calificación → segmentación;
:Publicar riesgo, razones y acciones sugeridas;
|Autoridad académica|
:Revisar el panel ejecutivo\ny las carreras prioritarias;
:Preguntar en lenguaje natural\nlo que el panel no muestra;
:Asignar recursos (tutorías, becas, consejería);
|Bienestar estudiantil|
:Abrir la lista priorizada (riesgo alto primero);
:Revisar la ficha: razones y trayectoria;
:Simular el efecto de una intervención;
if (¿Requiere acompañamiento?) then (sí)
  :Contactar al estudiante y registrar la intervención;
  :Cerrar la intervención con su resultado;
else (no)
  :Mantener seguimiento regular;
endif
|Sistema de alerta temprana|
:Comparar resultados con el siguiente cierre\n(monitoreo de deriva y reentrenamiento);
stop
@enduml
