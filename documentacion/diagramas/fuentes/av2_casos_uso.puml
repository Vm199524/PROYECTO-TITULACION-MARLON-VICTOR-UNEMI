@startuml av2_casos_uso
!include _estilo.iuml
title Casos de uso por rol
left to right direction
actor "Autoridad académica" as AUT
actor "Bienestar estudiantil" as BIE
actor "Administración de TI" as ATI
actor "Proveedor de IA" as LLM <<sistema externo>>

rectangle "Sistema web de alerta temprana de abandono" {
  usecase "CU-01 Ingresar y elegir\ninstitución activa" as CU1
  usecase "CU-02 Ver panel ejecutivo" as CU2
  usecase "CU-03 Consultar estudiantes\nen riesgo" as CU3
  usecase "CU-04 Ver ficha y razones\ndel riesgo (SHAP)" as CU4
  usecase "CU-05 Simular escenario\n«¿qué pasaría si…?»" as CU5
  usecase "CU-06 Registrar y cerrar\nintervención" as CU6
  usecase "CU-07 Preguntar en\nlenguaje natural" as CU7
  usecase "CU-08 Analizar carreras\ny referentes" as CU8
  usecase "CU-09 Revisar calidad\ndel modelo" as CU9
  usecase "CU-10 Descargar reporte\nejecutivo" as CU10
  usecase "CU-11 Administrar cuentas\ny roles" as CU11
  usecase "CU-12 Revisar auditoría y\nestado del sistema" as CU12
  usecase "CU-13 Ejecutar procesos\npor lotes" as CU13
}

AUT --> CU1
AUT --> CU2
AUT --> CU3
AUT --> CU4
AUT --> CU7
AUT --> CU8
AUT --> CU9
AUT --> CU10
BIE --> CU1
BIE --> CU3
BIE --> CU5
BIE --> CU6
BIE --> CU7
BIE --> CU10
ATI --> CU1
ATI --> CU11
ATI --> CU12
ATI --> CU13
ATI --> CU9
CU5 ..> CU4 : <<extend>>
CU6 ..> CU4 : <<extend>>
CU7 --> LLM : solo si no hay\nmétrica certificada
@enduml
