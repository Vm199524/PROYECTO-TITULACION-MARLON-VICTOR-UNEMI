@startuml av2_actividad_modelo
!include _estilo.iuml
title Diagrama de actividades del entrenamiento y la calificación (CRISP-DM)
start
:Leer trayectoria de la institución;
:Construir panel estudiante-periodo\n(etiqueta = abandono en t+1, sin fuga);
:Detectar grupos opcionales con datos\n(financieras, matrícula, aula virtual, evaluaciones);
:Separar los periodos más recientes\ncomo prueba temporal (≥ 25 %);
fork
  :Random Forest ponderado\n(búsqueda aleatoria);
fork again
  :Random Forest + SMOTE;
fork again
  :Regresión logística;
fork again
  :LightGBM ajustado con Optuna (TPE);
end fork
:Validación cruzada de 5 pliegues\nagrupada por estudiante;
:Elegir el modelo de mayor ROC-AUC media\n(desempate por PR-AUC);
:Calibrar con Platt sobre predicciones fuera de pliegue;
:Fijar umbrales: medio (recall ≥ 0,80) y alto (recall ≥ 0,50);
:Evaluar en la prueba temporal:\nROC-AUC, PR-AUC, Brier, captura top 10 %,\nequidad e importancia por permutación;
if (¿Institución OULAD con presentación en curso?) then (sí)
  :Evaluación prospectiva (2014J);
endif
:Guardar paquete .joblib y métricas;
:Calificar estudiantes activos\n+ explicación SHAP + PSI;
:Segmentar carreras (K-means validado);
stop
@enduml
