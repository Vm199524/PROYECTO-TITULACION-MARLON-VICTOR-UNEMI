@startuml av2_estados
!include _estilo.iuml
title Diagramas de estado: alerta del estudiante e intervención
state "Alerta de un estudiante activo" as AL {
  [*] --> SinCalificar
  SinCalificar : matrícula vigente sin predicción
  SinCalificar --> Bajo : p < umbral medio
  SinCalificar --> Medio : umbral medio ≤ p < umbral alto
  SinCalificar --> Alto : p ≥ umbral alto
  Bajo --> Medio : nueva calificación
  Medio --> Alto : nueva calificación
  Alto --> Medio : nueva calificación
  Medio --> Bajo : nueva calificación
  Alto --> EnSeguimiento : se registra una intervención
  Medio --> EnSeguimiento : se registra una intervención
  EnSeguimiento : intervención ABIERTA
  EnSeguimiento --> Atendido : se cierra con resultado
  Atendido --> Bajo : la siguiente calificación baja
  Atendido --> Alto : persiste el riesgo
  Bajo --> [*] : gradúa, egresa o\ntermina el periodo
  Alto --> [*] : abandona (RETIRADO)
}
state "Intervención" as IN {
  [*] --> ABIERTA : sp_registrar_intervencion
  ABIERTA --> CERRADA : sp_cerrar_intervencion(resultado)
  CERRADA --> [*]
}
@enduml
