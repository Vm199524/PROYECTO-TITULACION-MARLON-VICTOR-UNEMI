# ── VicMar Data AI — backend Python/FastAPI ─────────────────────────────────
# Copia este archivo como ".env" (mismo directorio, backend/.env) y rellena
# los valores reales. Auditoría 11/09/2026: esta plantilla estaba
# desactualizada — le faltaban variables imprescindibles para arrancar
# (CHAT_READER_*, DB_USER, DB_PASSWORD) y tenía variables de un script que
# ya no existe en este proyecto (DAUN_DB_*). Ahora refleja exactamente lo
# que el código real lee — ver docs/MANUAL_INSTALACION.md para el paso a
# paso completo de instalación.

# ── Cascada de proveedores de IA — gratuitos primero, de pago al final ─────
# Principio del proyecto: para pruebas / desarrollo, consumir SIEMPRE las
# APIs gratuitas primero; la clave de pago (DeepSeek) es solo para cuando
# el sistema se conecte a la base de datos de un cliente real que la pague.
# Con las 3 gratuitas vacías, el sistema sigue funcionando si DEEPSEEK_API_KEY
# tiene valor; con las 4 vacías, el chat responde con un error claro en vez
# de fallar en silencio.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# DeepSeek (de pago) — dejar vacío para desarrollo/pruebas con datos propios.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_VISION=deepseek-v4-flash-vision-exp

# FAL AI (texto a voz con ElevenLabs) — opcional. Vacío = la lectura en voz
# alta queda desactivada; el resto del sistema sigue igual (ver core/voz_fal.py).
FAL_KEY=

# ── SQL Server ───────────────────────────────────────────────────────────
# Apuntando al contenedor Docker de este proyecto (ver docs/MANUAL_INSTALACION.md).
QUERY_DATABASE=CHAT
DB_HOST=localhost,1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=sa
DB_PASSWORD=

# Login de SOLO LECTURA, exclusivo de la base CHAT (lo crea
# scripts/crear_chat_academico.sql). El SELECT final que genera la IA se
# ejecuta con esta cuenta, nunca con la de arriba — ver
# main.py::execute_chat_query y docs/AUDITORIA_2026-09-09.md.
CHAT_READER_USER=chat_reader
CHAT_READER_PASSWORD=

# ── API / CORS ───────────────────────────────────────────────────────────
# En producción: especificar el dominio real del frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Configuración del modelo de lenguaje ────────────────────────────────
HISTORY_DEPTH=4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600

# ── Seguridad (JWT) ──────────────────────────────────────────────────────
# APP_ENV=production hace que el backend se niegue a arrancar si
# JWT_SECRET_KEY sigue en su valor por defecto — dejar "development" para
# trabajo local. Para producción real, generar una cadena aleatoria larga,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_ENV=development
JWT_SECRET_KEY=cambia_esto_por_una_llave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Cache (Redis, opcional) ──────────────────────────────────────────────
# Vacío/no instalado = el backend funciona igual, sin cache (ver
# cache/redis_manager.py — cae a "sin cache", no rompe nada).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600

# ── Sentry (monitoreo de errores, opcional) ─────────────────────────────
# Vacío = el backend funciona igual, solo sin reportar errores a Sentry.
SENTRY_DSN=

# ── Correo saliente (SMTP) — "Olvidé mi contraseña" ─────────────────────
# Gmail con contraseña de aplicación (no tu contraseña normal): activa
# verificación en 2 pasos en tu cuenta de Google y genera una en
# https://myaccount.google.com/apppasswords. Vacío = el backend funciona
# igual, solo que no puede enviar el código de recuperación por correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=VicMar Data AI
