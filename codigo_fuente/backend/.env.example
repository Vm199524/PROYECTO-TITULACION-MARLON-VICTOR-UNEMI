# ── VicMar Data AI — configuración del backend (Python/FastAPI) ─────────────
# Copia este archivo como ".env" en esta misma carpeta (codigo_fuente/backend)
# y completa los valores. El archivo .env nunca se sube al repositorio.
# Paso a paso: documentacion/manuales/MANUAL_TECNICO_DE_INSTALACION.md
#
# Autores: Marlon David Pérez Almachi, Víctor Manuel Lluilema Pisco
# Proyecto de titulación · Universidad Estatal de Milagro · 2026

# ── Cascada de proveedores de IA — gratuitos primero, de pago al final ─────
# Se intentan en orden: Gemini → Groq → NVIDIA NIM → DeepSeek. Para pruebas
# y desarrollo bastan las claves gratuitas; DeepSeek (de pago) es para una
# institución que la contrate. Si todas están vacías, el chat responde con un
# mensaje claro y el resto del sistema (paneles, métricas certificadas) sigue
# funcionando.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# DeepSeek (de pago) — dejar vacío para desarrollo y pruebas.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_VISION=deepseek-v4-flash-vision-exp

# FAL AI (lectura en voz alta con ElevenLabs) — opcional. Vacío = la lectura
# en voz alta queda desactivada y el resto del sistema sigue igual.
FAL_KEY=

# ── SQL Server ───────────────────────────────────────────────────────────
# Contenedor Docker del proyecto (ver el manual técnico, sección «Base de datos»).
# DB_USER/DB_PASSWORD son la cuenta de administración que usan los procesos
# por lotes. También es la credencial que se usa cuando, en la pantalla
# «Bases de Datos», se deja vacío el campo de contraseña.
QUERY_DATABASE=CHAT
DB_HOST=localhost,1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=sa
DB_PASSWORD=

# Cuenta de SOLO LECTURA de la base CHAT, creada por
# codigo_fuente/base_de_datos/crear_chat_academico.sql. El SQL que genera la
# IA se ejecuta siempre con esta cuenta, nunca con la de administración
# (ver main.py::execute_chat_query).
CHAT_READER_USER=chat_reader
CHAT_READER_PASSWORD=

# 1 (recomendado) = si chat_reader no está disponible, la consulta a CHAT se
# rechaza. 0 = permite usar la sesión del usuario; solo para desarrollo.
CHAT_READER_OBLIGATORIO=1

# ── API / CORS ───────────────────────────────────────────────────────────
# En producción: indicar el dominio real del frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Modelo de lenguaje ───────────────────────────────────────────────────
HISTORY_DEPTH=4
LLM_TEMPERATURE=0.1
# Tokens máximos por respuesta. Valores bajos cortan las explicaciones largas.
LLM_MAX_TOKENS=1600

# ── Seguridad (JWT) ──────────────────────────────────────────────────────
# APP_ENV=production hace que el backend se niegue a arrancar si
# JWT_SECRET_KEY sigue en su valor por defecto; "development" para trabajo
# local. Para generar una llave larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_ENV=development
JWT_SECRET_KEY=cambia_esto_por_una_llave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Almacén de usuarios ──────────────────────────────────────────────────
# Por defecto los usuarios viven en codigo_fuente/backend/security_config.json
# (no se versiona). Con un bucket de Google Cloud Storage, el almacén se
# comparte entre varias instancias del backend.
USER_STORE_GCS_BUCKET=
# Primer administrador de una instalación nueva (opcional): si el almacén está
# vacío, se crea esta cuenta al arrancar. También la usa
# scripts/crear_usuario_desarrollador.py. La clave debe tener 8 o más caracteres.
TRIPLEA_BOOTSTRAP_ADMIN_USER=
TRIPLEA_BOOTSTRAP_ADMIN_PASSWORD=

# ── Caché (Redis, opcional) ──────────────────────────────────────────────
# Si Redis no está instalado, el backend funciona igual, sin caché.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600

# ── Sentry (monitoreo de errores, opcional) ─────────────────────────────
SENTRY_DSN=

# ── Correo saliente (SMTP) para «Olvidé mi contraseña» (opcional) ───────
# Con Gmail se usa una contraseña de aplicación (no la contraseña normal):
# activar la verificación en 2 pasos y generarla en
# https://myaccount.google.com/apppasswords. Vacío = no se envía el código
# de recuperación por correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=VicMar Data AI
