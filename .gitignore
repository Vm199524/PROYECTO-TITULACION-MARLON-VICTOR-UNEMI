# ══════════════════════════════════════════════════════════════════════════
# Proyecto de titulación — Marlon Pérez y Víctor Lluilema (UNEMI)
# Qué NO se sube al repositorio y por qué.
# ══════════════════════════════════════════════════════════════════════════

# ── Secretos y configuración local ────────────────────────────────────────
# Las credenciales viven solo en .env locales (ver los .env.example).
.env
*.env
.env.*
!.env.example
!**/.env.example
backend/security_config.json
backend/env.yaml

# ── Carpetas solo locales (no forman parte del repositorio) ───────────────
_POR_REVISAR_ELIMINAR/
_MATERIAL_EXTERNO_NO_SUBIR/
ANEXO_USO_ETICO_IA/

# ── Dependencias y entornos (se reinstalan) ───────────────────────────────
node_modules/
venv/
venv_*/
.venv/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# ── Builds ────────────────────────────────────────────────────────────────
dist/

# ── Datos ─────────────────────────────────────────────────────────────────
# Dataset público OULAD (CC BY 4.0, ~490 MB): se descarga aparte (ver datos/README.md).
datos/externos/
*.db
*.sqlite

# ── Datos de ejecución, cachés y logs del backend ─────────────────────────
# datos_locales/: cuentas de usuario (hash bcrypt), contraseñas de las cuentas
# de demostración, bitácora de auditoría y estado de los procesos por lotes.
backend/datos_locales/
backend/.cache/
backend/cache/
backend/debug/
backend/security_logs/
backend/tmp/
*.log
# Modelos entrenados y predicciones por estudiante: se regeneran con
# scripts/pipeline.py. Sí se versionan las métricas (JSON) de cada corrida.
backend/ml/modelos/*/*.joblib
backend/ml/modelos/*/*.csv

# ── Material con derechos de autor o datos personales ─────────────────────
# PDF de artículos científicos (se citan por DOI; no se redistribuyen) y exportaciones
# crudas de Scopus (los registros seleccionados están en los .ris).
documentacion/literatura/pdfs/
documentacion/literatura/*_scopus.csv
# Evidencias de tutorías con datos personales y documentos de la docente.
documentacion/evidencias_tutorias/
documentacion/observaciones_tutoras/Listado_Grupos_Temas_Recomendaciones.docx
# Contraseñas de los usuarios de prueba (se entregan aparte).
documentacion/tecnica/USUARIOS_DE_PRUEBA.md

# ── Archivos pesados ──────────────────────────────────────────────────────
*.mp4
*.mov
*.zip
*.rar

# ── Archivos temporales de Office y del sistema ───────────────────────────
~$*
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json

# Cuentas de prueba guardadas fuera de backend/datos_locales/: tampoco se versionan
backend/usuarios_prueba.local.json
backend/usuarios_demo.local.json

# Informe interactivo de Evidently (se regenera en cada monitoreo; pesa varios MB)
backend/ml/modelos/*/deriva_evidently.html

# ── Avance 3: carpetas solo para el Drive del grupo (datos personales y anexo de IA) ──
documentacion/avances/Avance 3/06_ANEXO_INTERACCION_IA/
documentacion/avances/Avance 3/07_ANEXO_INTERACCION_DOCENTES/
documentacion/avances/Avance 3/08_CEDULAS/
documentacion/avances/Avance 3/09_FOTOGRAFIAS/
documentacion/avances/Avance 3/05_DECLARACION_AUTORIA/
documentacion/avances/Avance 3/03_VIDEO_EXPLICACION_PRACTICA/

# Informes internos de auditoría del video técnico
documentacion/avances/Avance 3/14_VIDEO_TECNICO/auditoria_*.md

# Enlace o carpeta de dependencias y caché de compilación de TypeScript
frontend/node_modules
*.tsbuildinfo
